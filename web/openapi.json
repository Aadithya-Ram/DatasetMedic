  "components": {
    "schemas": {
      "AuditConfig": {
        "properties": {
          "roles": {
            "additionalProperties": {
              "type": "string",
              "enum": [
                "dataset",
                "train",
                "validation",
                "test"
              ]
            },
            "type": "object",
            "title": "Roles"
          },
          "target": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target"
          },
          "groups": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Groups"
          },
          "features": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Features"
          }
        },
        "type": "object",
        "title": "AuditConfig"
      },
      "Body_upload_api_sessions__sid__imports_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "separator": {
            "type": "string",
            "title": "Separator",
            "default": ","
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_api_sessions__sid__imports_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobRequest": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "audit",
              "preview",
              "export"
            ],
            "title": "Kind"
          },
          "config": {
            "$ref": "#/components/schemas/AuditConfig"
          },
          "recipe": {
            "$ref": "#/components/schemas/Recipe"
          },
          "output_format": {
            "type": "string",
            "enum": [
              "csv",
              "parquet"
            ],
            "title": "Output Format",
            "default": "parquet"
          }
        },
        "type": "object",
        "required": [
          "kind"
        ],
        "title": "JobRequest"
      },
      "Recipe": {
        "properties": {
          "steps": {
            "items": {
              "$ref": "#/components/schemas/Step"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Steps"
          }
        },
        "type": "object",
        "title": "Recipe"
      },
      "Step": {
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "drop",
              "deduplicate",
              "trim",
              "cast",
              "fill"
            ],
            "title": "Op"
          },
          "columns": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Columns"
          },
          "dtype": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "text",
                  "integer",
                  "decimal",
                  "boolean",
                  "date"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Dtype"
          },
          "method": {
            "type": "string",
            "enum": [
              "median",
              "mode",
              "constant"
            ],
            "title": "Method",
            "default": "median"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "type": "object",
        "required": [
          "op"
        ],
        "title": "Step"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
